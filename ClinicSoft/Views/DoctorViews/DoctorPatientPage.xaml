<Page x:Class="ClinicSoft.Views.DoctorViews.DoctorPatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      Title="Мои пациенты">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Пациенты" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,16"/>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                CornerRadius="4"
                MinHeight="36"
                Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="8,0,8,0"
                         TextChanged="SearchBox_TextChanged"
                         Foreground="#212121"
                         VerticalAlignment="Stretch"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по ФИО"
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <DataGrid x:Name="PatientsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  MouseDoubleClick="PatientsGrid_MouseDoubleClick"
                  RowHeight="60"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" 
                                    Binding="{Binding FullName}" 
                                    Width="*" 
                                    MinWidth="190"/>
                <DataGridTextColumn Header="Возраст" 
                                    Binding="{Binding Age}" 
                                    Width="80" 
                                    MinWidth="70"/>
                <DataGridTextColumn Header="Пол" 
                                    Binding="{Binding Gender}" 
                                    Width="70" 
                                    MinWidth="60"/>
                <DataGridTextColumn Header="Телефон" 
                                    Binding="{Binding Phone}" 
                                    Width="100" 
                                    MinWidth="90"/>
                <DataGridTemplateColumn Header="Действия" 
                                        Width="Auto" 
                                        MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Карточка" 
                                    HorizontalAlignment="Left"
                                    Tag="{Binding Id}" 
                                    Click="BtnViewCard_Click"
                                    Padding="8,2"
                                    Background="Transparent"
                                    Foreground="#1976D2"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>