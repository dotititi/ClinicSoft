<Page x:Class="ClinicSoft.Views.DoctorViews.DoctorDocumentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      Title="Документы">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Документы" 
                   Grid.Row="0"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,16"/>
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" 
                    Content="Создать документ" 
                    Padding="12,6"
                    MinWidth="120"
                    Click="BtnCreateDocument_Click"/>
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="36"
                    Margin="16,0,0,0">
                <Grid>
                    <TextBox x:Name="TxtSearch"
                             TextChanged="TxtSearch_TextChanged"
                             GotFocus="TxtSearch_GotFocus"
                             LostFocus="TxtSearch_LostFocus"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8,0,8,0"
                             VerticalContentAlignment="Center"
                             Foreground="#212121"
                             VerticalAlignment="Stretch"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по ФИО пациента..."
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <DataGrid x:Name="GeneratedDocumentsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  RowHeight="60"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" 
                        Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" 
                        Width="Auto" 
                        MinWidth="110"/>
                <DataGridTextColumn Header="Пациент" 
                        Binding="{Binding PatientName}" 
                        Width="*" 
                        MinWidth="190"/>
                <DataGridTextColumn Header="Тип документа" 
                        Binding="{Binding DocumentTypeName}" 
                        Width="*" 
                        MinWidth="150"/>
                <DataGridTemplateColumn Header="Действия" 
                            Width="Auto" 
                            MinWidth="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Просмотреть"
                                        Tag="{Binding Id}" 
                                        Click="BtnViewDocument_Click"
                                        Margin="0,0,4,0"
                                        Padding="8,2"
                                        Background="Transparent"
                                        Foreground="#1976D2"
                                        Cursor="Hand"/>
                                <Button Content="Редактировать"
                                        Tag="{Binding Id}" 
                                        Click="BtnEditDocument_Click"
                                        Padding="8,2"
                                        Background="Transparent"
                                        Foreground="#E65100"
                                        Cursor="Hand"/>
                                <Button Content="Сохранить PDF"
                                        Tag="{Binding Id}" 
                                        Click="BtnSavePdf_Click"
                                        Padding="8,2"
                                        Background="Transparent"
                                        Foreground="#388E3C"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>