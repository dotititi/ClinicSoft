<Window x:Class="ClinicSoft.Views.DoctorViews.LabResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты анализов" 
        Width="600" Height="350"
        WindowStartupLocation="CenterOwner"
        FontSize="13"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PatientInfo" 
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ResultsItemsControl" Margin="0,0,0,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{Binding TestName}" 
                                       FontWeight="Bold" 
                                       Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Результат:" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding ResultValue, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="4,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Единица:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding UnitSymbol}" 
                                           VerticalAlignment="Center" 
                                           Margin="4,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Норма:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding NormalRange}" 
                                           VerticalAlignment="Center" 
                                           Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    MinWidth="90" Height="32"
                    Padding="12,6"
                    Click="BtnCancel_Click"/>
            <Button Content="Сохранить" 
                    MinWidth="100" Height="32" 
                    Margin="12,0,0,0" 
                    Padding="12,6"
                    Click="BtnSave_Click" 
                    Background="#1976D2" 
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>