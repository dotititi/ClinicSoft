<Page x:Class="ClinicSoft.Views.DoctorViews.PatientCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Медицинская карта">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,24">
            <Button x:Name="BtnBack" 
                    Content="Назад" 
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#1976D2"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BtnBack_Click"
                    Margin="0,0,16,0"/>
            <StackPanel>
                <TextBlock x:Name="PatientFullName" 
                           FontSize="24" FontWeight="Bold"
                           Foreground="#1976D2"/>
                <TextBlock x:Name="PatientInfo" 
                           Foreground="#616161"
                           FontStyle="Italic"/>
            </StackPanel>
        </StackPanel>
        <TabControl Grid.Row="1" Padding="0,8,0,0">
            <TabItem Header="Общее">
                <ScrollViewer>
                    <StackPanel Margin="0,16">
                        <TextBlock Text="Контактная информация" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Телефон:" FontWeight="Bold"/>
                                <TextBlock x:Name="PhoneText" Margin="0,0,0,12"/>
                                <TextBlock Text="Email:" FontWeight="Bold"/>
                                <TextBlock x:Name="EmailText" Margin="0,0,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Полис:" FontWeight="Bold"/>
                                <TextBlock x:Name="InsuranceText" Margin="0,0,0,12"/>
                                <TextBlock Text="Дата рождения:" FontWeight="Bold"/>
                                <TextBlock x:Name="BirthdayText" Margin="0,0,0,12"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Анамнез" FontWeight="SemiBold" Margin="0,24,0,12"/>
                        <Border Background="#F8F9FA" CornerRadius="4" Padding="12">
                            <TextBlock x:Name="MedicalHistoryText" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="История приёмов">
                <DataGrid x:Name="VisitsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" 
                                            Binding="{Binding VisitTime, StringFormat='dd.MM.yyyy'}" 
                                            Width="Auto" MinWidth="140"/>
                        <DataGridTemplateColumn Header="Жалобы" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChiefComplaint}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,4"
                                               ToolTip="{Binding ChiefComplaint}"
                                               VerticalAlignment="Top"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Статус" 
                                            Binding="{Binding Status}" 
                                            Width="Auto" MinWidth="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Анализы">
                <DataGrid x:Name="LabOrdersGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" 
                                            Binding="{Binding OrderedAt, StringFormat='dd.MM.yyyy'}" 
                                            Width="Auto" MinWidth="110"/>
                        <DataGridTemplateColumn Header="Анализы" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TestTypes}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,4"
                                               ToolTip="{Binding TestTypes}"
                                               VerticalAlignment="Top"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Статус" 
                                            Binding="{Binding StatusDisplay}" 
                                            Width="Auto" MinWidth="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Диагнозы">
                <DataGrid x:Name="DiagnosesGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" 
                                            Binding="{Binding VisitTime, StringFormat='dd.MM.yyyy'}" 
                                            Width="Auto" MinWidth="110"/>
                        <DataGridTextColumn Header="Диагноз" 
                                            Binding="{Binding DiagnosisName}" 
                                            Width="*" MinWidth="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Лечение">
                <DataGrid x:Name="MedicationsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          VerticalScrollBarVisibility="Auto"
                          EnableRowVirtualization="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Препарат" 
                                            Binding="{Binding MedicationName}" 
                                            Width="*" MinWidth="160"/>
                        <DataGridTextColumn Header="Дозировка" 
                                            Binding="{Binding Dosage}" 
                                            Width="Auto" MinWidth="120"/>
                        <DataGridTextColumn Header="Длительность" 
                                            Binding="{Binding DurationDays, StringFormat={}{0} дн.}" 
                                            Width="Auto" MinWidth="100"/>
                        <DataGridTemplateColumn Header="Инструкция" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Instructions}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,4"
                                               ToolTip="{Binding Instructions}"
                                               VerticalAlignment="Top"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>