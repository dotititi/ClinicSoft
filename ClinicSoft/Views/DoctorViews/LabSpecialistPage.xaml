<Page x:Class="ClinicSoft.Views.DoctorViews.LabSpecialistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      Title="Лаборатория">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="BtnBack" 
                    Content="Назад" 
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#1976D2"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BtnBack_Click"
                    Margin="0,0,16,0"/>
            <TextBlock Text="Работа с анализами" 
                       FontSize="24" FontWeight="Bold"
                       Foreground="#1976D2"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                CornerRadius="4"
                MinHeight="36"
                Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="8,0,8,0"
                         TextChanged="SearchBox_TextChanged"
                         Foreground="#212121"
                         VerticalAlignment="Stretch"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по ФИО пациента..."
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <TabControl Grid.Row="2">
            <TabItem Header="Незавершённые">
                <DataGrid x:Name="PendingOrdersGrid"
                          RowHeight="60"    
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" 
                                            Binding="{Binding OrderedAt, StringFormat='dd.MM.yyyy'}" 
                                            Width="Auto" 
                                            MinWidth="70"/>
                        <DataGridTextColumn Header="Пациент" 
                                            Binding="{Binding PatientName}" 
                                            Width="*" 
                                            MinWidth="190"/>
                        <DataGridTemplateColumn Header="Анализы" 
                                                Width="*" 
                                                MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TestTypes}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,4"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding TestTypes}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Завершённые">
                <DataGrid x:Name="CompletedOrdersGrid"
                          RowHeight="60"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" 
                                            Binding="{Binding OrderedAt, StringFormat='dd.MM.yyyy'}" 
                                            Width="Auto" 
                                            MinWidth="70"/>
                        <DataGridTextColumn Header="Пациент" 
                                            Binding="{Binding PatientName}" 
                                            Width="*" 
                                            MinWidth="190"/>
                        <DataGridTemplateColumn Header="Анализы" 
                                                Width="*" 
                                                MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TestTypes}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="8,4"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding TestTypes}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Действия" 
                                                Width="Auto" 
                                                MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Открыть" 
                                            HorizontalAlignment="Left"
                                            Tag="{Binding Id}" 
                                            Click="ActionBtn_Click"
                                            Padding="8,2"
                                            Background="Transparent"
                                            Foreground="#4CAF50"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>