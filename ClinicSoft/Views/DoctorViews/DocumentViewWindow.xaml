<Window x:Class="ClinicSoft.Views.DoctorViews.DocumentViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр документа" 
        Height="700" Width="800"
        MinWidth="500"
        MinHeight="400"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        FontFamily="Segoe UI"
        FontSize="14"
        SizeToContent="Height">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" 
                   FontSize="20" FontWeight="Bold" 
                   Foreground="#1976D2" 
                   Margin="0,0,0,16"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="PatientText" Foreground="#212121"/>
            <TextBlock x:Name="TypeText" Foreground="#212121"/>
            <TextBlock x:Name="DateText" Foreground="#212121"/>
        </StackPanel>
        <TextBox x:Name="ContentText"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="12"
                 BorderBrush="#E0E0E0"
                 BorderThickness="1"
                 Background="White"
                 VerticalContentAlignment="Top"
                 MinHeight="200"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" 
                    x:Name="BtnSave"
                    MinWidth="100" MinHeight="32"
                    Padding="12,6"
                    Click="BtnSave_Click"
                    Background="#1976D2"
                    Foreground="White"/>
            <Button Content="Закрыть" 
                    MinWidth="80" MinHeight="32"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>