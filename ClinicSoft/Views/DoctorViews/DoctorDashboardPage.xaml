<Page x:Class="ClinicSoft.Views.DoctorViews.DoctorDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      Title="Рабочий стол">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Рабочий стол врача" 
                   FontSize="24" FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,24"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
            <Border Background="#E3F2FD" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Записей сегодня" Foreground="#1976D2"/>
                    <TextBlock x:Name="TodaysAppointmentsCount" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#E8F5E9" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Завершено сегодня" Foreground="#4CAF50"/>
                    <TextBlock x:Name="CompletedTodayCount" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Показать:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton Content="Сейчас" 
                             GroupName="TimeFilter" 
                             VerticalAlignment="Center"
                             IsChecked="True" 
                             Checked="TimeFilter_Checked"/>
                <RadioButton Content="Сегодня" 
                             GroupName="TimeFilter" 
                             VerticalAlignment="Center"
                             Margin="12,0,0,0" 
                             Checked="TimeFilter_Checked"/>
                <RadioButton Content="Завершённые" 
                             GroupName="TimeFilter" 
                             VerticalAlignment="Center"
                             Margin="12,0,0,0" 
                             Checked="TimeFilter_Checked"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="32"
                    Margin="24,0,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0,8,0"
                             TextChanged="SearchBox_TextChanged"
                             Foreground="#212121"
                             VerticalAlignment="Stretch"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по ФИО"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <DataGrid x:Name="PendingAppointmentsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  VerticalScrollBarVisibility="Auto"
                  EnableRowVirtualization="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                    <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                    <Setter Property="IsEnabled" Value="{Binding IsRowEnabled}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Время" 
                                    Binding="{Binding ScheduledTime, StringFormat='HH:mm'}" 
                                    Width="Auto" MinWidth="60"/>
                <DataGridTextColumn Header="Пациент" 
                                    Binding="{Binding PatientName}" 
                                    Width="*" MinWidth="190"/>
                <DataGridTemplateColumn Header="Причина обращения" Width="*" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Reason}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="8,4"
                                       VerticalAlignment="Top"
                                       ToolTip="{Binding Reason}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding StatusText}" 
                                    Width="Auto" MinWidth="80"/>
                <DataGridTemplateColumn Header="Действия" Width="Auto" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding ActionButtonText}"
                                        Click="ActionButton_Click"
                                        Tag="{Binding Id}"
                                        Background="Transparent"
                                        Foreground="{Binding ActionButtonColor}"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        Cursor="Hand"
                                        Visibility="{Binding PrimaryButtonVisibility}"/>
                                <Button Content="Отменить"
                                        Click="CancelAppointment_Click"
                                        Tag="{Binding Id}"
                                        Background="Transparent"
                                        Foreground="#F44336"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        Cursor="Hand"
                                        Visibility="{Binding CancelButtonVisibility}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>