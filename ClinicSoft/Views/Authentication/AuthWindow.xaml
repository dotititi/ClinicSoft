<Window x:Class="ClinicSoft.Views.Authentication.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicSoft — Авторизация" 
        Width="400" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        FontFamily="Segoe UI"
        FontSize="14"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Border Background="White"
                CornerRadius="12"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="368" Height="468">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="ClinicSoft"
                           FontSize="28" FontWeight="Bold"
                           Foreground="#1976D2"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"
                           Grid.Row="0"/>

                <TextBlock x:Name="Header"
                           Text="Вход в систему"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#212121"
                           Margin="0,0,0,16"
                           HorizontalAlignment="Center"
                           Grid.Row="1"/>
                <Grid Grid.Row="2" Margin="0,16,0,16">
                    <TextBox x:Name="LoginBox" 
                           Height="40"
                           Padding="12,0"
                           VerticalContentAlignment="Center"
                           TextChanged="LoginBox_TextChanged"/>
                    <TextBlock x:Name="LoginPlaceholder" 
                           Text="Логин"
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False"/>
                </Grid>
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <PasswordBox x:Name="PasswordBox" 
                           Height="40"
                           Padding="12,0"
                           VerticalContentAlignment="Center"
                           PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="PasswordPlaceholder" 
                           Text="Пароль"
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False"/>
                </Grid>
                <TextBlock x:Name="ErrorMessage"
                           Text=""
                           Foreground="#D32F2F"
                           FontSize="12"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Grid.Row="4"/>
                <Button x:Name="ActionButton"
                           Content="Войти"
                           Height="44"
                           Margin="0,0,0,20"
                           Click="ActionButton_Click"
                           Grid.Row="5"/>
                <StackPanel Grid.Row="6" 
                           HorizontalAlignment="Center"
                           Orientation="Horizontal">
                    <TextBlock x:Name="ToggleLabel"
                           Text="Нет аккаунта?"
                           Foreground="#616161"
                           VerticalAlignment="Center"/>
                    <Button x:Name="ToggleModeButton"
                            Content="Зарегистрироваться"
                            Background="Transparent"
                            Foreground="#1976D2"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="4,0"
                            Margin="8,0,0,0"
                            Click="ToggleModeButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>