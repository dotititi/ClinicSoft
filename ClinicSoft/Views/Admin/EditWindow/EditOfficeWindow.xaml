<Window x:Class="ClinicSoft.Views.Admin.EditWindow.EditOfficeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабинет" 
        Height="280" Width="350"
        MinWidth="300" MinHeight="280"
        MaxWidth="450" MaxHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        SizeToContent="Height">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="FormTitle"
                   FontSize="20"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Foreground="#1976D2"
                   Grid.Row="0"
                   Margin="0,0,0,24"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Номер кабинета *" 
                           Margin="0,0,0,4"
                           Foreground="#212121"/>
                <TextBox x:Name="TxtNumber" 
                         MinHeight="36" 
                         Padding="8,0"
                         MaxLength="10"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    MinWidth="80" MinHeight="32" 
                    Padding="12,6"
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave"
                    Content="Сохранить" 
                    MinWidth="100" MinHeight="32" 
                    Margin="12,0,0,0" 
                    Padding="12,6"
                    Click="BtnSave_Click" 
                    Background="#1976D2" 
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>