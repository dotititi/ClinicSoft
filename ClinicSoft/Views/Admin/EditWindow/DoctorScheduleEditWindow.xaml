<Window x:Class="ClinicSoft.Views.Admin.EditWindow.DoctorScheduleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расписание врача" 
        Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Foreground="#1976D2"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,24"/>
        <TextBlock Grid.Row="1" Text="Врач *" Margin="0,0,0,8"/>
        <ComboBox x:Name="CbDoctor" 
                  Grid.Row="2" 
                  MinHeight="36" 
                  Padding="8,4" 
                  DisplayMemberPath="Display"/>
        <TextBlock Grid.Row="3" Text="День недели *" Margin="0,16,0,8"/>
        <ComboBox x:Name="CbDayOfWeek" 
                  Grid.Row="4" 
                  MinHeight="36" 
                  Padding="8,4" 
                  SelectedValuePath="Key" 
                  DisplayMemberPath="Value"/>
        <TextBlock Grid.Row="5" Text="Время приёма *" Margin="0,16,0,8"/>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Начало" FontSize="13" Foreground="#616161" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtStartTime" 
                         Height="36" 
                         Padding="8,4" 
                         TextChanged="Time_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Окончание" FontSize="13" Foreground="#616161" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtEndTime" 
                         Height="36" 
                         Padding="8,4" 
                         TextChanged="Time_TextChanged"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="7" 
                   Text="Формат времени: ЧЧ:ММ (например: 09:30 или 18:30)" 
                   FontSize="11" 
                   Foreground="#757575"
                   FontStyle="Italic"
                   Margin="0,8,0,16"/>
        <CheckBox x:Name="CbIsWorking" 
                  Grid.Row="8" 
                  Content="Врач работает в этот день" 
                  VerticalAlignment="Top"/>
        <StackPanel Grid.Row="9" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,24,0,0">
            <Button x:Name="BtnSave" 
                    Content="Сохранить" 
                    MinWidth="100" 
                    Height="36" 
                    Padding="12,8" 
                    Click="BtnSave_Click" 
                    Margin="0,0,12,0"/>
            <Button Content="Отмена" 
                    MinWidth="100" 
                    Height="36" 
                    Padding="12,8" 
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>