<Window x:Class="ClinicSoft.Views.Admin.EditWindow.AdminEditUserRoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить роль пользователя" 
        Height="340" Width="480"
        MinWidth="350" MinHeight="300"
        MaxWidth="550" MaxHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        SizeToContent="Height">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Изменение роли" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="#1976D2"
                   Grid.Row="0"
                   Margin="0,0,0,24"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Текущая роль" 
                           Foreground="#212121"
                           Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtCurrentRole" 
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#1976D2"
                           Margin="0,0,0,24"/>
                <TextBlock Text="Новая роль *" 
                           Foreground="#212121"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="CbNewRole" 
                          MinHeight="36" 
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Id"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Grid.Row="2">
            <Button Content="Отмена" 
                    MinWidth="90" MinHeight="32" 
                    Padding="12,6"
                    Click="BtnCancel_Click"/>
            <Button Content="Сохранить" 
                    MinWidth="110" MinHeight="32" 
                    Margin="12,0,0,0" 
                    Padding="12,6"
                    Click="BtnSave_Click"
                    Background="#1976D2"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>