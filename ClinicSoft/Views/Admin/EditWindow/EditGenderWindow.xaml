<Window x:Class="ClinicSoft.Views.Admin.EditWindow.EditGenderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пол" 
        Width="400" Height="250"
        MinWidth="350" MinHeight="250"
        MaxWidth="500" MaxHeight="250"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        SizeToContent="Height">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="FormTitle"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1976D2"
                   Grid.Row="0"
                   Margin="0,0,0,24"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Название пола *" 
                           Margin="0,0,0,4"
                           Foreground="#212121"/>
                <TextBox x:Name="TxtName" 
                         MinHeight="36" 
                         Padding="8,0"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    MinWidth="80" MinHeight="32" 
                    Padding="12,6"
                    Click="BtnCancel_Click"/>
            <Button Content="Сохранить" 
                    MinWidth="100" MinHeight="32" 
                    Margin="12,0,0,0" 
                    Padding="12,6"
                    Click="BtnSave_Click"
                    x:Name="BtnSave"
                    Background="#1976D2"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>