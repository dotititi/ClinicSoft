<Page x:Class="ClinicSoft.Views.Admin.AdminUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователи"
      SizeChanged="Page_SizeChanged">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="SingleLineToolbar" Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Обновить" 
                        Click="BtnRefresh_Click"
                        Background="#1976D2"
                        Foreground="White"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="100"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Изменить роль" 
                        Margin="8,0,0,0"
                        Click="BtnChangeRole_Click"
                        IsEnabled="False"
                        x:Name="BtnChangeRole"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="120"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Сбросить пароль" 
                        Margin="8,0,0,0"
                        Click="BtnResetPassword_Click"
                        IsEnabled="False"
                        x:Name="BtnResetPassword"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="140"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="32"
                    Margin="16,0,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по логину"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="MultiLineToolbar" Grid.Row="0" Margin="0,0,0,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Обновить" 
                        Click="BtnRefresh_Click"
                        Background="#1976D2"
                        Foreground="White"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="100"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Изменить роль" 
                        Margin="8,0,0,0"
                        Click="BtnChangeRole_Click"
                        IsEnabled="False"
                        x:Name="BtnChangeRole2"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="120"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Сбросить пароль" 
                        Margin="8,0,0,0"
                        Click="BtnResetPassword_Click"
                        IsEnabled="False"
                        x:Name="BtnResetPassword2"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="140"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="32"
                    Margin="0,8,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox2"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder2"
                               Text="Поиск по логину"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <DataGrid x:Name="UserDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MinRowHeight="60"
                  SelectionChanged="UserDataGrid_SelectionChanged"
                  VerticalScrollBarVisibility="Auto"
                  EnableRowVirtualization="False">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" 
                                    Binding="{Binding Login}" 
                                    Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="Роль" 
                                    Binding="{Binding RoleName}" 
                                    Width="Auto" MinWidth="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>