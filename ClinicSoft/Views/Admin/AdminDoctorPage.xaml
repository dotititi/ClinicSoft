<Page x:Class="ClinicSoft.Views.Admin.AdminDoctorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Врачи"
      SizeChanged="Page_SizeChanged">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="SingleLineToolbar" Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить врача" 
                        Click="BtnAddDoctor_Click"
                        Background="#1976D2"
                        Foreground="White"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="140"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Редактировать" 
                        Margin="12,0,0,0"
                        Click="BtnEditDoctor_Click"
                        IsEnabled="False"
                        x:Name="BtnEdit"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="120"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Удалить" 
                        Margin="12,0,0,0"
                        Click="BtnDeleteDoctor_Click"
                        IsEnabled="False"
                        x:Name="BtnDelete"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="100"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="32"
                    Margin="24,0,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по ФИО/почте/логину"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="MultiLineToolbar" Grid.Row="0" Margin="0,0,0,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить врача" 
                        Click="BtnAddDoctor_Click"
                        Background="#1976D2"
                        Foreground="White"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="140"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Редактировать" 
                        Margin="12,0,0,0"
                        Click="BtnEditDoctor_Click"
                        IsEnabled="False"
                        x:Name="BtnEdit2"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="120"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Удалить" 
                        Margin="12,0,0,0"
                        Click="BtnDeleteDoctor_Click"
                        IsEnabled="False"
                        x:Name="BtnDelete2"
                        Padding="12,8"
                        MinHeight="32"
                        MinWidth="100"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="32"
                    Margin="0,8,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox2"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder2"
                               Text="Поиск по ФИО/почте/логину"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <DataGrid x:Name="DoctorDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  MinRowHeight="60"
                  SelectionChanged="DoctorDataGrid_SelectionChanged"
                  VerticalScrollBarVisibility="Auto"
                  EnableRowVirtualization="False">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="ФИО" Width="*" MinWidth="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="8,4"
                                       VerticalAlignment="Top"
                                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                        <Binding Path="LastName"/>
                                        <Binding Path="FirstName"/>
                                        <Binding Path="MiddleName"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Специальность" 
                                    Binding="{Binding Speciality.Name}" 
                                    Width="*" MinWidth="120"/>
                <DataGridTextColumn Header="Отделение" 
                                    Binding="{Binding Department.Name}" 
                                    Width="*" MinWidth="150"/>
                <DataGridTextColumn Header="Кабинет" 
                                    Binding="{Binding Office.Number}" 
                                    Width="Auto" MinWidth="70"/>
                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding Status.Name}" 
                                    Width="Auto" MinWidth="100"/>
                <DataGridTextColumn Header="Почта" 
                                    Binding="{Binding Email}" 
                                    Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="Логин" 
                                    Binding="{Binding User.Login}" 
                                    Width="Auto" MinWidth="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>