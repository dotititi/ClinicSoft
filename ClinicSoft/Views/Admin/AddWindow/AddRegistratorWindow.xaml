<Window x:Class="ClinicSoft.Views.Admin.AddWindow.AddRegistratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить регистратора" 
        Height="540" Width="500"
        MinWidth="400" MinHeight="450"
        MaxWidth="600" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        SizeToContent="Height">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Добавление нового регистратора" 
                   FontSize="20" FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,24"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Фамилия *" Margin="0,0,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtLastName" MinHeight="36" Padding="8,0"/>
                <TextBlock Text="Имя *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtFirstName" MinHeight="36" Padding="8,0"/>
                <TextBlock Text="Отчество" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtMiddleName" MinHeight="36" Padding="8,0"/>
                <TextBlock Text="Дата рождения *" Margin="0,12,0,4" Foreground="#212121"/>
                <DatePicker x:Name="DpBirthday" MinHeight="36"/>
                <TextBlock Text="Email *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtEmail" 
                         MinHeight="36" 
                         Padding="8,0"/>
                <TextBlock x:Name="EmailHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Пример: reg@clinic.ru</TextBlock>
                <TextBlock Text="Телефон *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtPhone" 
                         MinHeight="36" 
                         Padding="8,0"
                         Text="+7 "
                         PreviewTextInput="TxtPhone_PreviewTextInput"
                         PreviewKeyDown="TxtPhone_PreviewKeyDown"
                         TextChanged="TxtPhone_TextChanged"/>
                <TextBlock x:Name="PhoneHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Формат: +7 XXX XXX-XX-XX</TextBlock>
                <TextBlock Text="Пол *" Margin="0,12,0,4" Foreground="#212121"/>
                <ComboBox x:Name="CbGender" 
                          MinHeight="36" 
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    MinWidth="90" MinHeight="32" 
                    Padding="12,6" 
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" 
                    Content="Добавить" 
                    MinWidth="120" MinHeight="32" 
                    Margin="12,0,0,0" 
                    Padding="12,6"
                    Click="BtnSave_Click" 
                    Background="#1976D2" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>