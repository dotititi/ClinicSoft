<Window x:Class="ClinicSoft.Views.Admin.AddWindow.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый пациент" 
        Height="740" Width="520"
        MinWidth="400" MinHeight="500"
        MaxWidth="600" MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        SizeToContent="Height">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Добавление нового пациента" 
                   FontSize="20" FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,24"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Фамилия *" Margin="0,0,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtLastName" MinHeight="36" Padding="8,0"/>
                <TextBlock Text="Имя *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtFirstName" MinHeight="36" Padding="8,0"/>
                <TextBlock Text="Отчество" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtMiddleName" MinHeight="36" Padding="8,0"/>
                <TextBlock Text="Дата рождения *" Margin="0,12,0,4" Foreground="#212121"/>
                <DatePicker x:Name="DpBirthday" 
                            MinHeight="36" 
                            SelectedDateChanged="DpBirthday_SelectedDateChanged"/>
                <TextBlock Text="Пол *" Margin="0,12,0,4" Foreground="#212121"/>
                <ComboBox x:Name="CbGender" MinHeight="36">
                    <ComboBoxItem Content="Мужской"/>
                    <ComboBoxItem Content="Женский"/>
                </ComboBox>
                <TextBlock Text="Телефон *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtPhone" 
                         MinHeight="36" 
                         Padding="8,0"
                         Text="+7 "
                         PreviewTextInput="TxtPhone_PreviewTextInput"
                         PreviewKeyDown="TxtPhone_PreviewKeyDown"
                         TextChanged="TxtPhone_TextChanged"/>
                <TextBlock x:Name="PhoneHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Формат: +7 XXX XXX-XX-XX</TextBlock>
                <TextBlock Text="Email *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtEmail" 
                         MinHeight="36" 
                         Padding="8,0"
                         TextChanged="TxtEmail_TextChanged"/>
                <TextBlock x:Name="EmailHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Пример: ivanov@mail.ru</TextBlock>
                <TextBlock Text="Медицинская карта" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="#1976D2"
                           Margin="0,24,0,16"/>
                <TextBlock Text="Номер полиса *" Margin="0,0,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtInsurance" 
                         MinHeight="36" 
                         Padding="8,0"
                         MaxLength="16"
                         PreviewTextInput="TxtInsurance_PreviewTextInput"
                         PreviewKeyDown="TxtInsurance_PreviewKeyDown"
                         TextChanged="TxtInsurance_TextChanged"/>
                <TextBlock x:Name="InsuranceHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Только 16 цифр без пробелов</TextBlock>
                <TextBlock Text="Аллергии *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtAllergies" 
                         MinHeight="70" 
                         Padding="8,0"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Хронические заболевания *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtChronic" 
                         MinHeight="70" 
                         Padding="8,0"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    MinWidth="90" MinHeight="32" 
                    Padding="12,6" 
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" 
                    Content="Добавить" 
                    MinWidth="120" MinHeight="32" 
                    Margin="12,0,16,0" 
                    Padding="12,6"
                    Click="BtnSave_Click" 
                    Background="#1976D2" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>