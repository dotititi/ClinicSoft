<Page x:Class="ClinicSoft.Views.Admin.AdminDoctorSchedulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Расписание врачей"
      SizeChanged="Page_SizeChanged">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="SingleLineToolbar" Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" 
                        x:Name="BtnAdd"
                        MinWidth="120"
                        Padding="12,8"
                        Click="BtnAdd_Click"/>
                <Button Content="Редактировать" 
                        x:Name="BtnEdit"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Click="BtnEdit_Click"
                        IsEnabled="False"/>
                <Button Content="Удалить" 
                        x:Name="BtnDelete"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Click="BtnDelete_Click"
                        IsEnabled="False"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="32"
                    Margin="16,0,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по врачу или дню недели"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="MultiLineToolbar" Grid.Row="0" Margin="0,0,0,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Добавить" 
                        x:Name="BtnAdd2"
                        MinWidth="120"
                        Padding="12,8"
                        Click="BtnAdd_Click"/>
                <Button Content="Редактировать" 
                        x:Name="BtnEdit2"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Click="BtnEdit_Click"
                        IsEnabled="False"/>
                <Button Content="Удалить" 
                        x:Name="BtnDelete2"
                        MinWidth="120"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        Click="BtnDelete_Click"
                        IsEnabled="False"/>
            </StackPanel>
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="32"
                    Margin="0,8,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox2"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPlaceholder2"
                               Text="Поиск по врачу или дню недели"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <DataGrid x:Name="DgSchedules"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="DgSchedules_SelectionChanged"
                  RowHeight="40"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="День недели" Binding="{Binding DayOfWeek}" Width="120" MinWidth="100"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime}" Width="80" MinWidth="70"/>
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndTime}" Width="80" MinWidth="70"/>
                <DataGridTextColumn Header="Работает" Binding="{Binding IsWorkingDisplay}" Width="80" MinWidth="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>