<Page x:Class="ClinicSoft.Views.PatientViews.PatientDocumentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои документы">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Мои документы" 
                   Grid.Row="0"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,16"/>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                CornerRadius="4"
                MinHeight="36"
                Margin="0,0,0,24">
            <Grid>
                <TextBox x:Name="TxtSearch"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="8,0,8,0"
                         TextChanged="TxtSearch_TextChanged"
                         Foreground="#212121"
                         VerticalAlignment="Stretch"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по типу документа..."
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <DataGrid x:Name="DocumentsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  RowHeight="60"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" 
                                    Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" 
                                    Width="Auto" MinWidth="120"/>
                <DataGridTextColumn Header="Тип документа" 
                                    Binding="{Binding DocumentTypeName}" 
                                    Width="*" MinWidth="180"/>
                <DataGridTemplateColumn Header="Действия" Width="Auto" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Открыть"
                                    Tag="{Binding Id}"
                                    Click="BtnOpenDocument_Click"
                                    Padding="8,2"
                                    Background="Transparent"
                                    Foreground="#1976D2"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>