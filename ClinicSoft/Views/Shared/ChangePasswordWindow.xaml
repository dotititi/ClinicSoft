<Window x:Class="ClinicSoft.Views.Shared.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" 
        Width="480" Height="460"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        ResizeMode="NoResize">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Смена пароля" 
                   FontSize="24" FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,28"
                   HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Текущий пароль *" Margin="0,0,0,8" Foreground="#212121"/>
            <PasswordBox x:Name="TxtCurrentPassword" Height="44" Padding="12,0"/>
            <TextBlock Text="Новый пароль *" Margin="0,16,0,8" Foreground="#212121"/>
            <PasswordBox x:Name="TxtNewPassword" Height="44" Padding="12,0"/>
            <TextBlock Text="Подтверждение *" Margin="0,16,0,8" Foreground="#212121"/>
            <PasswordBox x:Name="TxtConfirmPassword" Height="44" Padding="12,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" 
                    MinWidth="100" Height="40" 
                    Padding="16,8" 
                    Click="BtnCancel_Click"/>
            <Button Content="Сохранить" 
                    MinWidth="120" Height="40" 
                    Margin="16,0,0,0" 
                    Padding="16,8"
                    Click="BtnSave_Click" 
                    Background="#1976D2" 
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>