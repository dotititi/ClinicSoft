<Window x:Class="ClinicSoft.Views.Registrator.RegistratorProfileSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки профиля" 
        Height="650" Width="500"
        MaxHeight="650" MinHeight="400"
        MinWidth="400" MaxWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        SizeToContent="Height">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="WindowTitleText" 
           Text="Настройки профиля регистратора" 
           FontSize="20" FontWeight="Bold"
           Foreground="#1976D2"
           Margin="0,0,0,24"
           TextWrapping="Wrap"
           TextTrimming="CharacterEllipsis"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Фамилия *" Margin="0,0,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtLastName" Height="36" Padding="8,0"/>
                <TextBlock Text="Имя *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtFirstName" Height="36" Padding="8,0"/>
                <TextBlock Text="Отчество" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtMiddleName" Height="36" Padding="8,0"/>
                <TextBlock Text="Дата рождения *" Margin="0,12,0,4" Foreground="#212121"/>
                <DatePicker x:Name="DpBirthday" Height="36"/>
                <TextBlock Text="Пол" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtGender" 
                         Height="36" 
                         Padding="8,0"
                         IsReadOnly="True"
                         Background="#F5F5F5"/>
                <TextBlock Text="Email *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtEmail" 
                         Height="36" 
                         Padding="8,0"/>
                <TextBlock x:Name="EmailHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Пример: reg@clinic.ru</TextBlock>
                <TextBlock Text="Телефон *" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtPhone" 
                         Height="36" 
                         Padding="8,0"
                         Text="+7 "
                         PreviewTextInput="TxtPhone_PreviewTextInput"
                         PreviewKeyDown="TxtPhone_PreviewKeyDown"
                         TextChanged="TxtPhone_TextChanged"/>
                <TextBlock x:Name="PhoneHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Формат: +7 XXX XXX-XX-XX</TextBlock>
                <TextBlock Text="Логин" Margin="0,12,0,4" Foreground="#212121"/>
                <TextBox x:Name="TxtLogin" 
                         Height="36" 
                         Padding="8,0"
                         IsReadOnly="True"
                         Background="#F5F5F5"/>
                <TextBlock x:Name="LoginHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Логин изменить нельзя</TextBlock>
                <Border x:Name="InitialSetupHint"
                        Background="#E3F2FD"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <TextBlock Text="Заполните ваш профиль для полного доступа к системе.&#10;Логин и пароль остаются без изменений." 
                               TextWrapping="Wrap"
                               Foreground="#1976D2"
                               FontStyle="Italic"
                               FontSize="12"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" 
                    Content="Отмена" 
                    MinWidth="90" Height="36" 
                    Padding="12,0" 
                    Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" 
                    Content="Сохранить изменения" 
                    MinWidth="160" Height="36" 
                    Margin="12,0,0,0" 
                    Padding="12,0"
                    Click="BtnSave_Click" 
                    Background="#1976D2" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>