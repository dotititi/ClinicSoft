<Page x:Class="ClinicSoft.Views.Registrator.PatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пациенты">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Добавить пациента" 
                        MinWidth="140"
                        Padding="12,8"
                        Click="BtnAddPatient_Click"/>
                <Button Content="Редактировать" 
                        MinWidth="120"
                        Margin="12,0,0,0"
                        Padding="12,8"
                        Click="BtnEditContact_Click"
                        IsEnabled="False" 
                        x:Name="BtnEditContact"/>
            </StackPanel>
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#BDBDBD"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinHeight="36"
                    Margin="24,0,0,0">
                <Grid>
                    <TextBox x:Name="SearchBox" 
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="8,0,8,0"
                             TextChanged="SearchBox_TextChanged"
                             Foreground="#212121"
                             VerticalAlignment="Stretch"/>
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Поиск по ФИО или номеру телефона"
                               Foreground="#9E9E9E"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>
        <DataGrid x:Name="PatientDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="PatientDataGrid_SelectionChanged"
                  RowHeight="60"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="ФИО" Width="*" MinWidth="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1} {2}">
                                        <Binding Path="LastName"/>
                                        <Binding Path="FirstName"/>
                                        <Binding Path="MiddleName"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Дата рожд." 
                                    Binding="{Binding Birthday, StringFormat=dd.MM.yyyy}" 
                                    Width="*" 
                                    MinWidth="70"/>
                <DataGridTextColumn Header="Телефон" 
                                    Binding="{Binding Phone}" 
                                    Width="*" 
                                    MinWidth="90"/>
                <DataGridTextColumn Header="Полис" 
                                    Binding="{Binding MedicalCard.InsuranceNumber}" 
                                    Width="*" 
                                    MinWidth="130"/>
                <DataGridTemplateColumn Header="Действия" Width="Auto" MinWidth="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="Мед. карта" 
                                        Tag="{Binding Id}" 
                                        Click="BtnViewMedicalCard_Click"
                                        Background="Transparent"
                                        Foreground="#FF9800"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        Cursor="Hand"/>
                                <Button Content="Анализы" 
                                        Tag="{Binding Id}" 
                                        Click="BtnViewLabTests_Click"
                                        Background="Transparent"
                                        Foreground="#2196F3"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        Cursor="Hand"/>
                                <Button Content="Лечение" 
                                        Tag="{Binding Id}" 
                                        Click="BtnViewTreatments_Click"
                                        Background="Transparent"
                                        Foreground="#4CAF50"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        Cursor="Hand"/>
                                <Button Content="Документы" 
                                        Tag="{Binding Id}" 
                                        Click="BtnViewDocuments_Click"
                                        Background="Transparent"
                                        Foreground="#1976D2"
                                        BorderThickness="0"
                                        Padding="8,2"
                                        Margin="8,0,0,0"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>