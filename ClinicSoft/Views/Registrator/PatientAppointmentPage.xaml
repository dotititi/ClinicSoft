<Page x:Class="ClinicSoft.Views.Registrator.PatientAppointmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Все записи">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Все записи" 
                   FontSize="24" FontWeight="Bold"
                   Foreground="#1976D2"
                   Margin="0,0,0,16"/>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                CornerRadius="4"
                Height="36"
                Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="SearchBox"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="8,0,8,0"
                         TextChanged="SearchBox_TextChanged"
                         Foreground="#212121"
                         VerticalAlignment="Stretch"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по ФИО пациента или врача..."
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <DataGrid x:Name="AppointmentsGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  RowHeight="60"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding ScheduledTime, StringFormat='dd.MM.yyyy'}" Width="Auto" MinWidth="70"/>
                <DataGridTextColumn Header="Время" Binding="{Binding ScheduledTime, StringFormat='HH:mm'}" Width="Auto" MinWidth="60"/>
                <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*" MinWidth="190"/>
                <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="*" MinWidth="190"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusDisplay}" Width="*" MinWidth="100"/>
                <DataGridTemplateColumn Header="Причина" Width="*" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Reason}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="8,4"
                                       VerticalAlignment="Center"
                                       ToolTip="{Binding Reason}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Действия" Width="Auto" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Подробнее"
                                    Tag="{Binding Id}"
                                    Click="BtnViewDetails_Click"
                                    Background="Transparent"
                                    Foreground="#1976D2"
                                    BorderThickness="0"
                                    Padding="8,2"
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>