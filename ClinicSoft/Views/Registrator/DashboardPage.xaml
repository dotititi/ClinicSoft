<Page x:Class="ClinicSoft.Views.Registrator.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Панель регистратора" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="#1976D2"
                       Margin="0,0,0,24"/>
            <WrapPanel Grid.Row="1" 
                       Orientation="Horizontal"
                       MaxWidth="820"
                       HorizontalAlignment="Left">
                <Border Background="#E3F2FD" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,16,16"
                        MinHeight="120" MaxHeight="140"
                        Width="390">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Rectangle Fill="#1976D2" Width="4" Height="24" RadiusX="2" RadiusY="2" Margin="0,0,12,0"/>
                            <TextBlock Text="Записей сегодня" 
                                       Foreground="#1976D2"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="TodaysAppointments" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   Foreground="#1976D2"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="актуально на сегодня"
                                   FontSize="11"
                                   Foreground="#757575"
                                   FontStyle="Italic"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#E3F2FD" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,16"
                        MinHeight="120" MaxHeight="140"
                        Width="390">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Rectangle Fill="#1976D2" Width="4" Height="24" RadiusX="2" RadiusY="2" Margin="0,0,12,0"/>
                            <TextBlock Text="Всего пациентов" 
                                       Foreground="#1976D2"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalPatients" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   Foreground="#1976D2"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="в базе данных"
                                   FontSize="11"
                                   Foreground="#757575"
                                   FontStyle="Italic"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#F3E5F5" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,16,0"
                        MinHeight="120" MaxHeight="140"
                        Width="390">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Rectangle Fill="#7B1FA2" Width="4" Height="24" RadiusX="2" RadiusY="2" Margin="0,0,12,0"/>
                            <TextBlock Text="Активных врачей" 
                                       Foreground="#7B1FA2"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="ActiveDoctors" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   Foreground="#7B1FA2"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="готовы к приёму"
                                   FontSize="11"
                                   Foreground="#757575"
                                   FontStyle="Italic"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#E8F5E9" 
                        CornerRadius="12" 
                        Padding="20"
                        Margin="0,0,0,0"
                        MinHeight="120" MaxHeight="140"
                        Width="390">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Rectangle Fill="#388E3C" Width="4" Height="24" RadiusX="2" RadiusY="2" Margin="0,0,12,0"/>
                            <TextBlock Text="Ожидающих анализов" 
                                       Foreground="#388E3C"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="PendingLabTests" 
                                   FontSize="36" 
                                   FontWeight="Bold"
                                   Foreground="#388E3C"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="требуют обработки"
                                   FontSize="11"
                                   Foreground="#757575"
                                   FontStyle="Italic"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</Page>