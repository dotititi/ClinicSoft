<Page x:Class="ClinicSoft.Views.Registrator.LabOrderDetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Просмотр анализа">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnBack" 
                    Content="Назад" 
                    Padding="12,8"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#1976D2"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BtnBack_Click"
                    Margin="0,0,16,0"/>
            <TextBlock Text="Полная информация об анализе" 
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1976D2"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="BtnSavePdf"
                Grid.Row="1"
                Content="Сохранить PDF"
                HorizontalAlignment="Left"
                Margin="0,12,0,16"
                Padding="16,8"
                MinWidth="140"
                Background="#1976D2"
                Foreground="White"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="BtnSavePdf_Click"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Общая информация" Margin="0,0,0,16">
                    <StackPanel Margin="8">
                        <TextBlock><Run FontWeight="Bold">Пациент:</Run> <Run x:Name="PatientNameText"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Дата:</Run> <Run x:Name="OrderDateText"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Назначивший врач:</Run> <Run x:Name="DoctorNameText"/></TextBlock>
                        <TextBlock><Run FontWeight="Bold">Статус:</Run> <Run x:Name="StatusText"/></TextBlock>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Назначенные анализы" Margin="0,0,0,16">
                    <DataGrid x:Name="AssignedTestsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="100">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Padding" Value="12,4"/>
                                <Setter Property="Background" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Анализ" Width="*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TestName}"
                                                   TextWrapping="Wrap"
                                                   Padding="12,4"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Единица" Binding="{Binding Unit}" Width="*" MinWidth="80"/>
                            <DataGridTemplateColumn Header="Норма" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NormalRange}"
                                                   TextWrapping="Wrap"
                                                   Padding="12,4"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <GroupBox Header="Результаты">
                    <DataGrid x:Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="150">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="Padding" Value="12,4"/>
                                <Setter Property="Background" Value="#1976D2"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Анализ" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TestName}"
                                                   TextWrapping="Wrap"
                                                   Padding="12,4"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Результат" Binding="{Binding ResultValue}" Width="*" MinWidth="80"/>
                            <DataGridTextColumn Header="Единица" Binding="{Binding Unit}" Width="*" MinWidth="80"/>
                            <DataGridTemplateColumn Header="Норма" Width="*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ReferenceRange}"
                                                   TextWrapping="Wrap"
                                                   Padding="12,4"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>