<Page x:Class="ClinicSoft.Views.Registrator.DoctorsListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Врачи">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Врачи" 
                   FontSize="24" FontWeight="Bold"
                   Foreground="#1976D2"
                   VerticalAlignment="Center"
                   Margin="0,0,0,16"/>
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#BDBDBD"
                BorderThickness="1"
                CornerRadius="4"
                Height="36"
                Margin="0,0,0,16">
            <Grid>
                <TextBox x:Name="TxtSearch"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="8,0,8,0"
                         TextChanged="TxtSearch_TextChanged"
                         Foreground="#212121"
                         VerticalAlignment="Stretch"/>
                <TextBlock x:Name="SearchPlaceholder"
                           Text="Поиск по ФИО или кабинету"
                           Foreground="#9E9E9E"
                           VerticalAlignment="Center"
                           Margin="8,0,8,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <DataGrid x:Name="DgDoctors"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="True"
                  RowHeaderWidth="0"
                  SelectionUnit="FullRow"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  BorderThickness="1"
                  BorderBrush="#E0E0E0"
                  Background="White"
                  RowBackground="White">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="Background" Value="#1976D2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" 
                                    Binding="{Binding FullName}" 
                                    Width="*" 
                                    MinWidth="220"/>
                <DataGridTextColumn Header="Специальность" 
                                    Binding="{Binding Speciality}" 
                                    Width="2*" 
                                    MinWidth="150"/>
                <DataGridTextColumn Header="Кабинет" 
                                    Binding="{Binding Office}" 
                                    Width="Auto" 
                                    MinWidth="80"/>
                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding Status}" 
                                    Width="Auto" 
                                    MinWidth="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>