<Window x:Class="ClinicSoft.Views.Registrator.EditPatientContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать данные пациента" 
        Height="720" Width="480"
        MaxHeight="720" MinHeight="500"
        MinWidth="420" MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA"
        FontFamily="Segoe UI"
        FontSize="14"
        SizeToContent="Height">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Редактирование данных пациента" 
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="#1976D2"
                   Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Фамилия *" Foreground="#212121" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtLastName" Height="36" Padding="8,0"/>
                <TextBlock Text="Имя *" Foreground="#212121" Margin="0,8,0,4"/>
                <TextBox x:Name="TxtFirstName" Height="36" Padding="8,0"/>
                <TextBlock Text="Отчество" Foreground="#212121" Margin="0,8,0,4"/>
                <TextBox x:Name="TxtMiddleName" Height="36" Padding="8,0"/>
                <TextBlock Text="Дата рождения *" Foreground="#212121" Margin="0,12,0,4"/>
                <DatePicker x:Name="DpBirthday" 
                            Height="36" 
                            SelectedDateChanged="DpBirthday_SelectedDateChanged"/>
                <TextBlock x:Name="BirthdayHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Формат: дд.мм.гггг</TextBlock>
                <TextBlock Text="Пол *" Foreground="#212121" Margin="0,12,0,4"/>
                <ComboBox x:Name="CbGender" Height="36">
                    <ComboBoxItem Content="Мужской" Tag="M"/>
                    <ComboBoxItem Content="Женский" Tag="F"/>
                </ComboBox>
                <TextBlock Text="Телефон *" Foreground="#212121" Margin="0,16,0,4"/>
                <TextBox x:Name="TxtPhone" 
                         Height="36" 
                         Padding="8,0" 
                         Text="+7 " 
                         PreviewTextInput="TxtPhone_PreviewTextInput"
                         PreviewKeyDown="TxtPhone_PreviewKeyDown"
                         TextChanged="TxtPhone_TextChanged"/>
                <TextBlock x:Name="PhoneHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Формат: +7 XXX XXX-XX-XX</TextBlock>
                <TextBlock Text="Email *" Foreground="#212121" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtEmail" 
                         Height="36" 
                         Padding="8,0"
                         TextChanged="TxtEmail_TextChanged"/>
                <TextBlock x:Name="EmailHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Пример: patient@example.com</TextBlock>
                <TextBlock Text="Номер полиса *" Foreground="#212121" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtInsurance" 
                         Height="36" 
                         Padding="8,0" 
                         MaxLength="16"
                         PreviewTextInput="TxtInsurance_PreviewTextInput"
                         PreviewKeyDown="TxtInsurance_PreviewKeyDown"
                         TextChanged="TxtInsurance_TextChanged"/>
                <TextBlock x:Name="InsuranceHint" FontSize="11" Foreground="#757575" Margin="0,-4,0,8">Только 16 цифр без пробелов</TextBlock>
                <TextBlock Text="Аллергии *" Foreground="#212121" Margin="0,16,0,4"/>
                <TextBox x:Name="TxtAllergies" 
                         MinHeight="70" 
                         Padding="8" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"/>
                <TextBlock Text="Хронические заболевания *" Foreground="#212121" Margin="0,12,0,4"/>
                <TextBox x:Name="TxtChronic" 
                         MinHeight="70" 
                         Padding="8" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    MinWidth="90" Height="36" 
                    Padding="12,0"
                    Click="BtnCancel_Click"
                    Background="White"
                    BorderBrush="#1976D2"
                    Foreground="#1976D2"/>
            <Button x:Name="BtnSave" 
                    Content="Сохранить" 
                    MinWidth="140" Height="36" 
                    Margin="12,0,0,0" 
                    Padding="12,0"
                    Click="BtnSave_Click"
                    Background="#1976D2" 
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>